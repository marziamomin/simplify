{
  "manifest_version": 3,
  "name": "Simplify",
  "version": "1.0",
  "description": "Simplify selected text using Gemini API",
  "icons": {
    "48": "icons/icon48.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}